# --- Database: either a full SQLAlchemy URL ... ---
# DATABASE_URL=mysql+mysqlconnector://readonly_user:password@localhost:3306/shop
# DATABASE_URL=postgresql+psycopg2://readonly_user:password@localhost:5432/shop
# DATABASE_URL=sqlite:///./sample.db

# --- ... or the MySQL settings (used when DATABASE_URL is not set) ---
MYSQL_HOST=localhost
MYSQL_USER=readonly_user
MYSQL_PASSWORD=
MYSQL_DATABASE=shop
MYSQL_PORT=3306

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Tuning ---
TOP_K_TABLES=8      # tables sent to the model per question
MAX_ROWS=1000       # rows returned per query
# API_URL=http://127.0.0.1:8000   # where the Streamlit UI finds the backend
